// Market Terminal iOS — shared build settings.
// The web application is canonical; this shell only hosts it. Never put secrets here.

PRODUCT_NAME = Market Terminal
PRODUCT_BUNDLE_IDENTIFIER = com.krishivjain.marketterminal
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0

// Signing: Personal Team + automatic signing is the intended route (see ios/README.md).
// DEVELOPMENT_TEAM is deliberately NOT set here; Xcode writes the chosen team into the
// project when you pick it under Signing & Capabilities. To pin it without Xcode, put
// DEVELOPMENT_TEAM = XXXXXXXXXX in Config/Local.xcconfig (git-ignored).
CODE_SIGN_STYLE = Automatic

// Canonical production origin. HTTPS only. Read at runtime from Info.plist
// (MarketTerminalBaseURL) — do not repeat the literal anywhere in Swift.
MARKET_TERMINAL_BASE_URL = https:/$()/market-terminal.wyjjdyxzsc.workers.dev

// Local Mac instance for the Development configuration (Simulator reaches the Mac's
// loopback; a physical iPhone cannot — see README "Developing against a local server").
MARKET_TERMINAL_DEV_URL = http:/$()/localhost:3000

// Which URL the app boots into: production | development
MARKET_TERMINAL_ENV = production

INFOPLIST_FILE = MarketTerminal/Resources/Info.plist
