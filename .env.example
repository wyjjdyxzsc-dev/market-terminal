# ─────────────────────────────────────────────────────────────
#  Market Terminal — environment
#  Copy this file to ".env" and fill in the values.
# ─────────────────────────────────────────────────────────────

# REQUIRED for the TERMINAL tab (quotes, profile, metrics, company news, search).
# Get a free key at https://finnhub.io  (Dashboard -> API Key)
FINNHUB_API_KEY=

# Port the local server listens on
PORT=3000

# Recommended speed-tier provider for NEWS and generic research.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the AI model. Default is openai/gpt-oss-120b.
# GROQ_MODEL=

# Optional speed-tier providers. Each model can be overridden with the matching
# *_MODEL variable; current defaults live in shared/ai-provider-registry.js.
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=

# Heavy providers. Generated current-market/high-risk tasks need at least two
# eligible providers serving different canonical model families or they abstain.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
GITHUB_MODELS_TOKEN=
AI21_API_KEY=

# Variable/brokered routers are medium-risk only and cannot independently verify
# high-risk output.
OPENROUTER_API_KEY=
HF_API_KEY=

# Optional bounded lower-risk race width. High-risk execution remains sequential.
AI_PARALLEL=5

# Optional admin protection for diagnostics and push-test routes.
ADMIN_API_TOKEN=

# OPTIONAL — only needed for breaking-news push notifications (ALERTS tab).
# Generate a keypair once with:  npx web-push generate-vapid-keys
# Leave blank to simply disable push (the rest of the app still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
